{
  "name": "@repo/remark-toc",
  "version": "1.0.0",
  "description": "A remark plugin to generate a table of contents to an object from a markdown file",
  "type": "module",
  "author": {
    "name": "Hao Le",
    "email": "haoln.7f8@gmail.com"
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts",
    "lint": "eslint . --ext .ts"
  },
  "dependencies": {
    "unist-util-visit": "5.1.0",
    "github-slugger": "^2.0.0"
  },
  "devDependencies": {
    "@repo/tsconfig": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@types/mdast": "^4.0.0",
    "eslint": "catalog:dev",
    "remark": "catalog:markdown",
    "typescript": "catalog:dev",
    "tsdown": "^0.22.14",
    "vfile": "^6.0.3"
  }
}
